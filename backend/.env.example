# Copie este arquivo para .env (que fica fora do Git) e preencha.
# Nunca coloque a chave em outro lugar.

# Provedor de IA: gemini, fake ou replay. Sem chave, o padrão é fake.
AI_PROVIDER=fake

# Chave criada no Google AI Studio.
GEMINI_API_KEY=

# Nome do modelo do Gemini, conferido no painel do AI Studio (T00).
GEMINI_MODEL=gemini-3.6-flash

# Endereço da tela que pode chamar o servidor (CORS).
ALLOWED_ORIGIN=http://localhost:5173
